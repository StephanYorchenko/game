{
  "name": "@deathwarriors/game-core",
  "version": "0.0.0",
  "private": true,
  "description": "Независимое от интерфейса ядро DeathWarriors",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pathfinding": {
      "types": "./dist/pathfinding.d.ts",
      "import": "./dist/pathfinding.js"
    },
    "./geometry": {
      "types": "./dist/geometry.d.ts",
      "import": "./dist/geometry.js"
    },
    "./stats": {
      "types": "./dist/stats.d.ts",
      "import": "./dist/stats.js"
    },
    "./random": {
      "types": "./dist/random.d.ts",
      "import": "./dist/random.js"
    },
    "./initiative": {
      "types": "./dist/initiative.d.ts",
      "import": "./dist/initiative.js"
    },
    "./execution": {
      "types": "./dist/execution-queue.d.ts",
      "import": "./dist/execution-queue.js"
    },
    "./effects": {
      "types": "./dist/effects.d.ts",
      "import": "./dist/effects.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "node --test",
    "check": "pnpm run typecheck && pnpm run build && pnpm test"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
