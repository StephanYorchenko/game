{
  "name": "deathwarriors",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "check": "pnpm -r run check",
    "dev:ui": "pnpm --filter @deathwarriors/game-core build && pnpm --filter @deathwarriors/game-ui dev",
    "test:ui": "pnpm --filter @deathwarriors/game-core build && pnpm --filter @deathwarriors/game-ui build && pnpm --filter @deathwarriors/game-ui test",
    "example:simulation": "pnpm --filter @deathwarriors/game-core build && pnpm --filter @deathwarriors/game-core example:simulation"
  }
}
